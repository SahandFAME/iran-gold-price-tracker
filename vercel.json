{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/daily_update.py": {
      "maxDuration": 300
    },
    "api/telegram.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/daily_update",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/telegram_profile_once",
      "schedule": "39 10 * * *"
    }
  ]
}
